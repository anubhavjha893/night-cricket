# Copy to .env. Never commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/ugm_cricket
PORT=4000
# Set NODE_ENV=production on the public HTTPS host.
APP_ORIGIN=http://localhost:4000,http://localhost:5173,http://127.0.0.1:5173
# Generate your own long random secret. Minimum 32 characters.
JWT_SECRET=
# First server start creates the administrator only if this email does not exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: configure the verified payment account here, or use Admin > Settings.
PAYMENT_UPI_ID=8210708838sbi@axl
PAYMENT_PAYEE_NAME=Anubhav Jha
# Optional external frontend hosting. Empty means same-origin /api.
VITE_API_URL=
# Only for a separate frontend origin over HTTPS; same-origin deployment uses lax.
COOKIE_SAME_SITE=lax
# One reverse proxy in front of Express; use 0 for direct local connections.
TRUST_PROXY=0
