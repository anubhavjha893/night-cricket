# Copy to .env. Never commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/ugm_cricket
PORT=4000
# Set NODE_ENV=production on the public HTTPS host.
APP_ORIGIN=http://localhost:4000,http://localhost:5173,http://127.0.0.1:5173
# Generate your own long random secret. Minimum 32 characters.
JWT_SECRET=
# First server start creates the administrator only if this email does not exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: configure the verified payment account here, or use Admin > Settings.
PAYMENT_UPI_ID=8210708838sbi@axl
PAYMENT_PAYEE_NAME=Anubhav Jha
# Only for a separate frontend origin over HTTPS; same-origin deployment uses lax.
COOKIE_SAME_SITE=lax
# Direct connections use 0. Do not use numeric proxy hop counts in production.
TRUST_PROXY=0
# Comma-separated exact proxy IPs/CIDRs from your host, never 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=
# Optional privacy-safe request logs. No body, credentials, query text or IP logged.
REQUEST_LOGS=false
# Shared MongoDB rate counters. Defaults assume up to 40 active dashboard users
# and up to 300 registrations/hour behind one campus/mobile-network IP.
RATE_API_PER_MINUTE=600
RATE_LOGIN_IP=180
RATE_LOGIN_ACCOUNT=12
RATE_REGISTRATION_IP=300
# Enable only after all old instances are drained (two-phase password upgrade).
PASSWORD_SCHEME_ENABLED=false
