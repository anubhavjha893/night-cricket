{
  "name": "ugm-cricket-registration",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:database": "npm run dev:database --workspace backend",
    "build": "npm run build --workspace frontend && node scripts/prepare-site.mjs",
    "start": "npm run start --workspace backend",
    "test": "npm run test --workspace backend",
    "test:browser": "node tests/e2e/browser.mjs",
    "preview": "npm run preview --workspace frontend",
    "format": "prettier --write frontend/src backend/src backend/scripts backend/tests tests/e2e frontend/vite.config.js scripts"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "playwright": "^1.56.1",
    "mongodb-memory-server": "^10.3.0",
    "mongoose": "^9.0.0",
    "prettier": "^3.6.2"
  }
}
